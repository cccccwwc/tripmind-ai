
# LLM 服务配置
# 模型名称
LLM_MODEL_ID=your-model-name

# API密钥
LLM_API_KEY=your-api-key-here

# 服务地址
LLM_BASE_URL=your-api-base-url

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60

# Tavily 实时搜索（https://app.tavily.com/）
TAVILY_API_KEY=your_tavily_api_key_here

# MCP外部工具调用超时时间（秒）
MCP_CALL_TIMEOUT=30

# 高德 MCP 内部 HTTP 超时（秒）
AMAP_HTTP_CONNECT_TIMEOUT=6
AMAP_HTTP_READ_TIMEOUT=15

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# 长期旅行记忆 SQLite 文件（可选）
# TRAVEL_MEMORY_DB_PATH=./data/travel_memory.db

# LangGraph 工作流检查点（可选；支持审批、中断和恢复）
# LANGGRAPH_CHECKPOINT_PATH=./data/langgraph_checkpoints.db

# Unsplash API Credentials
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""

# 高德地图API配置
AMAP_API_KEY=your_amap_api_key_here
